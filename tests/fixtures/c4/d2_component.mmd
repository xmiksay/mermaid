C4Component
title Order service components
Container(spa, "Web SPA", "Vue 3", "Customer UI")
ContainerQueue(bus, "Event bus", "Kafka", "Domain events")
ContainerDb(pg, "Orders DB", "Postgres", "Orders, lines, payments")
ContainerDb(redis, "Cache", "Redis")
System_Ext(psp, "Payment provider", "Stripe")
Container_Boundary(api, "Order API") {
  Component(ctrl, "Order controller", "Axum handler", "HTTP endpoints for orders")
  Component(svc, "Order service", "Rust", "Business rules, pricing, validation")
  Component(repo, "Order repository", "SeaORM", "Persistence")
  Component(pay, "Payment adapter", "reqwest", "Talks to PSP")
  Component(pub, "Event publisher", "rdkafka", "Outbox relay")
  ComponentQueue(outbox, "Outbox", "table", "Pending events")
  Component(cache, "Price cache", "moka", "Hot prices")
}
Rel(spa, ctrl, "Places orders", "JSON/HTTPS")
Rel(ctrl, svc, "Calls")
Rel(svc, repo, "Reads/writes")
Rel(repo, pg, "SQL", "TCP")
BiRel(svc, cache, "Get/put prices")
Rel(cache, redis, "Backs onto")
Rel(svc, pay, "Charges")
Rel(pay, psp, "Charge API", "HTTPS")
Rel_Back(svc, psp, "Webhook: payment succeeded")
Rel(svc, outbox, "Appends event")
Rel(pub, outbox, "Polls")
Rel(pub, bus, "Publishes", "Kafka protocol")
Rel_Back(spa, bus, "Order status updates via SSE bridge")
BiRel(repo, outbox, "Same transaction")
